---
import ArrowIcon from './ArrowIcon.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <img
      src="/images/hero-bg-2400.jpg"
      srcset="/images/hero-bg-1200.jpg 1200w, /images/hero-bg-2400.jpg 2400w"
      sizes="100vw"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal>Human-centered AI consulting for C-suite leaders and founders</p>
      <h1 class="display hero__title" data-split style="--split-delay:150ms">
        Turn Underperforming AI Adoption Into <em>Measurable Time and Cost Savings</em>
      </h1>
      <p class="lede hero__lede" data-reveal style="--i:2">
        I help C-suite leaders and founders turn underperforming AI adoption into measurable time and cost
        savings. I start by identifying where AI can create business value, redesign how people and AI work
        together, rebuild the workflow around it, and align reward systems so the new way of working sticks.
      </p>
      <p class="hero__note" data-reveal style="--i:3">
        Bring one business priority. A Direction Call helps clarify the outcome you want, the work involved,
        and the right next step.
      </p>
      <div class="hero__actions" data-reveal style="--i:4">
        <a class="btn" href={site.bookingUrl} data-magnetic>Book a Direction Call <ArrowIcon /></a>
        <a class="btn btn--ghost" href="#method" data-magnetic>Explore the Approach</a>
      </div>
    </div>

    <div class="hero__card" data-reveal style="--i:5">
      <p class="hero__card-label">The method</p>
      <ol role="list">
        <li><Icon name="users-three" /><span>Work</span></li>
        <li><Icon name="tree-structure" /><span>Workflow</span></li>
        <li><Icon name="trend-up" /><span>Value</span></li>
      </ol>
    </div>
  </div>

  <a class="hero__scroll" href="#opportunity" aria-label="Scroll to the next section">
    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: max(100dvh, 720px);
    padding: clamp(120px, 15vh, 160px) 0 clamp(96px, 12vh, 140px);
    overflow: hidden;
    isolation: isolate;
  }

  /* Full-width background photo */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__bg {
    background: var(--paper);
  }
  .hero__bg img {
    position: absolute;
    top: 0;
    right: 0;
    width: 76%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
    filter: saturate(0.82) contrast(1.02);
    animation: hero-settle 2.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.08);
      opacity: 0;
    }
  }
  /* Paper wash from the left so the navy copy reads over the photo */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(245, 244, 240, 1) 0%, rgba(245, 244, 240, 1) 24%, rgba(245, 244, 240, 0.82) 38%, rgba(245, 244, 240, 0.3) 56%, rgba(245, 244, 240, 0) 72%),
      linear-gradient(180deg, rgba(245, 244, 240, 0.55) 0%, rgba(245, 244, 240, 0) 22%);
  }
  /* Slow drift as the page scrolls away */
  @supports (animation-timeline: view()) {
    .hero__bg {
      animation: hero-drift linear both;
      animation-timeline: view();
      animation-range: exit;
    }
    @keyframes hero-drift {
      to {
        transform: translateY(12%);
      }
    }
  }

  .hero__inner {
    position: relative;
    width: 100%;
  }
  .hero__copy {
    max-width: 700px;
  }
  .hero__title {
    margin-top: 28px;
    font-size: clamp(40px, 5vw, 70px);
  }
  .hero__title em {
    color: var(--teal-deep);
  }
  .hero__lede {
    margin-top: 32px;
    max-width: 58ch;
    color: var(--ink-soft);
  }
  .hero__note {
    margin-top: 28px;
    padding-left: 20px;
    border-left: 1px solid var(--teal);
    max-width: 52ch;
    font-size: 15.5px;
    color: var(--ink-soft);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .hero__actions .btn--ghost {
    background: rgba(245, 244, 240, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* Floating method card over the photo */
  .hero__card {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(-60px, -6vh, -40px);
    width: 290px;
    padding: 22px 24px;
    background: rgba(245, 244, 240, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 30px 60px -30px rgba(15, 26, 45, 0.35);
  }
  .hero__card-label {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .hero__card ol {
    list-style: none;
    margin-top: 12px;
  }
  .hero__card li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1;
  }
  .hero__card li + li {
    border-top: 1px solid var(--line);
  }
  .hero__card li :global(.icon) {
    width: 24px;
    height: 24px;
    color: var(--teal);
  }
  .hero__card li::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    opacity: 0.25;
    animation: card-pulse 3.6s var(--ease) infinite;
  }
  .hero__card li:nth-child(2)::after {
    animation-delay: 1.2s;
  }
  .hero__card li:nth-child(3)::after {
    animation-delay: 2.4s;
  }
  @keyframes card-pulse {
    0%,
    60%,
    100% {
      opacity: 0.2;
      transform: translateY(-50%) scale(1);
    }
    20% {
      opacity: 1;
      transform: translateY(-50%) scale(1.6);
    }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    transform: translateX(-50%);
    animation: scroll-nudge 2.4s ease-in-out infinite;
  }
  .hero__scroll svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
  }
  @keyframes scroll-nudge {
    50% {
      transform: translate(-50%, 5px);
    }
  }

  @media (max-width: 1099px) {
    .hero__card {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-top: 0;
    }
    /* On phones the photo sits on top and the copy follows on paper */
    .hero__bg {
      position: relative;
      inset: auto;
      z-index: 0;
      width: 100%;
      aspect-ratio: 4 / 3;
      margin-top: 76px;
      animation: none;
    }
    .hero__bg::after {
      background: linear-gradient(180deg, rgba(245, 244, 240, 0) 55%, rgba(245, 244, 240, 1) 100%);
    }
    .hero__bg img {
      position: static;
      width: 100%;
      object-position: 78% center;
    }
    .hero__inner {
      margin-top: -24px;
    }
    .hero__scroll {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__bg,
    .hero__bg img,
    .hero__card li::after,
    .hero__scroll {
      animation: none;
    }
  }
</style>
