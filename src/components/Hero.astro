---
import ArrowIcon from './ArrowIcon.astro';
import Icon from './Icon.astro';
import ImageSlot from './ImageSlot.astro';
import { site } from '../data/site';

// Scattered "AI activity" points that converge into one direction.
const scatter = [
  [52, 470], [104, 522], [34, 398], [148, 456], [88, 372], [168, 516], [126, 414], [22, 506],
];
const converge = [214, 430];
const dots: [number, number][] = [];
for (let x = 20; x <= 500; x += 32) for (let y = 20; y <= 540; y += 32) dots.push([x, y]);
---

<section class="hero" id="top">
  <div class="wrap grid hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal>Human-centered AI consulting for C-suite leaders and founders</p>
      <h1 class="display hero__title" data-split style="--split-delay:150ms">
        Turn Underperforming AI Adoption Into <em>Measurable Time and Cost Savings</em>
      </h1>
      <p class="lede hero__lede" data-reveal style="--i:2">
        I help C-suite leaders and founders turn underperforming AI adoption into measurable time and cost
        savings. I start by identifying where AI can create business value, redesign how people and AI work
        together, rebuild the workflow around it, and align reward systems so the new way of working sticks.
      </p>
      <p class="hero__note" data-reveal style="--i:3">
        Bring one business priority. A Direction Call helps clarify the outcome you want, the work involved,
        and the right next step.
      </p>
      <div class="hero__actions" data-reveal style="--i:4">
        <a class="btn" href={site.bookingUrl} data-magnetic>Book a Direction Call <ArrowIcon /></a>
        <a class="btn btn--ghost" href="#method" data-magnetic>Explore the Approach</a>
      </div>
    </div>

    <figure class="hero__figure" aria-hidden="true" data-draw>
      <svg viewBox="0 0 520 560" class="direction">
        <g class="direction__grid">
          {dots.map(([x, y]) => <circle cx={x} cy={y} r="1" />)}
        </g>

        <g class="direction__activity">
          {scatter.map(([x, y], i) => (
            <path
              d={`M${x} ${y} Q ${(x + converge[0]) / 2 + (i % 2 ? 18 : -14)} ${(y + converge[1]) / 2 + (i % 3 ? -16 : 20)} ${converge[0]} ${converge[1]}`}
              style={`--d:${i * 70}ms`}
            />
          ))}
          {scatter.map(([x, y]) => <circle cx={x} cy={y} r="3.2" />)}
        </g>

        <g class="direction__compass">
          <circle class="direction__ring" cx="430" cy="112" r="74" />
          <g class="direction__ticks">
            {Array.from({ length: 24 }, (_, i) => (
              <line x1="430" y1={112 - 74} x2="430" y2={112 - (i % 6 === 0 ? 64 : 69)} transform={`rotate(${i * 15} 430 112)`} />
            ))}
          </g>
          <circle class="direction__ring direction__ring--inner" cx="430" cy="112" r="44" />
        </g>
        <circle class="direction__pulse" cx="430" cy="112" r="6" />

        <path
          class="direction__path"
          pathLength="1"
          d="M214 430 C 240 396, 246 366, 262 336 S 316 262, 336 238 S 398 162, 430 112 L 468 54"
        />
        <path class="direction__head" d="M472.4 47.3 L469.7 62.3 L466.9 55.7 L459.7 55.7 Z" />

        <g class="direction__nodes">
          <g style="--d:900ms"><circle cx="214" cy="430" r="5" /><text x="232" y="452">AI activity</text></g>
          <g style="--d:1150ms"><circle cx="262" cy="336" r="6" /><text x="282" y="340">Work</text></g>
          <g style="--d:1400ms"><circle cx="336" cy="238" r="6" /><text x="356" y="242">Workflow</text></g>
          <g style="--d:1650ms"><circle cx="430" cy="112" r="6" /><text x="350" y="116" text-anchor="end">Value</text></g>
        </g>
      </svg>
      <figcaption class="hero__caption">
        <span>Suunta</span> &nbsp;/&nbsp; direction, in Finnish
      </figcaption>
    </figure>
  </div>

  <div class="wrap hero__band">
    <ImageSlot label="Executive team working session, natural light" ratio="21 / 9" tone="navy" class="hero__img" eager />
    <div class="hero__card" data-reveal style="--i:2">
      <p class="hero__card-label">The method</p>
      <ol role="list">
        <li><Icon name="users-three" /><span>Work</span></li>
        <li><Icon name="tree-structure" /><span>Workflow</span></li>
        <li><Icon name="trend-up" /><span>Value</span></li>
      </ol>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(128px, 16vh, 176px) 0 clamp(72px, 9vw, 120px);
  }
  .hero__band {
    position: relative;
    margin-top: clamp(64px, 8vw, 112px);
  }
  .hero__card {
    position: absolute;
    right: calc(var(--gutter) + clamp(16px, 3vw, 48px));
    bottom: clamp(-48px, -3vw, -24px);
    z-index: 3;
    width: min(320px, 70%);
    padding: 24px 26px;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -30px rgba(15, 26, 45, 0.35);
  }
  .hero__card-label {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .hero__card ol {
    list-style: none;
    margin-top: 14px;
  }
  .hero__card li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1;
  }
  .hero__card li + li {
    border-top: 1px solid var(--line);
  }
  .hero__card li :global(.icon) {
    width: 24px;
    height: 24px;
    color: var(--teal);
  }
  .hero__card li::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    opacity: 0.25;
    animation: card-pulse 3.6s var(--ease) infinite;
  }
  .hero__card li:nth-child(2)::after {
    animation-delay: 1.2s;
  }
  .hero__card li:nth-child(3)::after {
    animation-delay: 2.4s;
  }
  @keyframes card-pulse {
    0%,
    60%,
    100% {
      opacity: 0.2;
      transform: translateY(-50%) scale(1);
    }
    20% {
      opacity: 1;
      transform: translateY(-50%) scale(1.6);
    }
  }
  .hero__grid {
    align-items: center;
    row-gap: 56px;
  }
  .hero__copy {
    grid-column: 1 / 8;
  }
  .hero__title {
    margin-top: 28px;
    font-size: clamp(40px, 5vw, 68px);
  }
  .hero__title em {
    color: var(--teal-deep);
  }
  .hero__lede {
    margin-top: 32px;
  }
  .hero__note {
    margin-top: 28px;
    padding-left: 20px;
    border-left: 1px solid var(--teal);
    max-width: 56ch;
    font-size: 15.5px;
    color: var(--ink-soft);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .hero__figure {
    grid-column: 8 / 13;
    margin: 0;
  }
  .hero__caption {
    margin-top: 8px;
    text-align: right;
    font-size: 13px;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }
  .hero__caption span {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    color: var(--ink);
  }

  .direction {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .direction__grid circle {
    fill: var(--ink);
    opacity: 0.13;
  }
  .direction__activity path {
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0.55;
  }
  .direction__activity circle {
    fill: var(--paper);
    stroke: var(--ink-muted);
    stroke-width: 1.2;
  }
  .direction__ring {
    fill: none;
    stroke: var(--teal);
    stroke-width: 1;
    opacity: 0.22;
  }
  .direction__compass {
    transform-origin: 430px 112px;
    animation: compass-turn 60s linear infinite;
  }
  @keyframes compass-turn {
    to {
      transform: rotate(360deg);
    }
  }
  .direction__ticks line {
    stroke: var(--teal);
    stroke-width: 1;
    opacity: 0.35;
  }
  .direction__pulse {
    fill: none;
    stroke: var(--teal);
    stroke-width: 1.2;
    transform-origin: 430px 112px;
    animation: node-pulse 2.8s var(--ease) 2.6s infinite;
    opacity: 0;
  }
  @keyframes node-pulse {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(4.5);
    }
  }
  .direction__ring--inner {
    stroke-dasharray: 2 5;
    opacity: 0.4;
  }
  .direction__path {
    fill: none;
    stroke: var(--teal);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .direction__head {
    fill: var(--teal);
  }
  .direction__nodes circle {
    fill: var(--paper);
    stroke: var(--teal);
    stroke-width: 1.6;
  }
  .direction__nodes g:first-child circle {
    stroke: var(--ink-muted);
  }
  .direction__nodes text {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--ink);
  }
  .direction__nodes g:first-child text {
    fill: var(--ink-muted);
  }

  /* Draw-in sequence */
  :global(.js) .direction__path {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.9s cubic-bezier(0.65, 0, 0.35, 1) 0.5s;
  }
  :global(.js) .direction__head,
  :global(.js) .direction__nodes g,
  :global(.js) .direction__activity path {
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }
  :global(.js) .direction__head {
    transition-delay: 2.2s;
  }
  :global(.js) .direction__nodes g {
    transition-delay: var(--d);
  }
  :global(.js) .direction__activity path {
    transition-delay: var(--d);
  }
  :global(.js) .hero__figure.is-in .direction__path {
    stroke-dashoffset: 0;
  }
  :global(.js) .hero__figure.is-in .direction__head,
  :global(.js) .hero__figure.is-in .direction__nodes g {
    opacity: 1;
  }
  :global(.js) .hero__figure.is-in .direction__activity path {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .direction__compass,
    .direction__pulse,
    .hero__card li::after {
      animation: none;
    }
    :global(.js) .direction__path {
      stroke-dashoffset: 0;
      transition: none;
    }
    :global(.js) .direction__head,
    :global(.js) .direction__nodes g {
      opacity: 1;
      transition: none;
    }
    :global(.js) .direction__activity path {
      opacity: 0.55;
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .hero__band :global(.hero__img) {
      aspect-ratio: 4 / 3 !important;
    }
    .hero__card {
      position: relative;
      right: auto;
      bottom: auto;
      width: auto;
      margin: -40px 16px 0;
    }
    .hero__figure {
      max-width: 420px;
      margin-left: auto;
    }
  }
</style>
