---
import ImageSlot from './ImageSlot.astro';
import IconBadge from './IconBadge.astro';
import Icon from './Icon.astro';
import { credentials, site } from '../data/site';
---

<section class="section section--tint about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="grid about__grid">
      <div class="about__intro">
        <p class="eyebrow" data-reveal>About John Hyttinen</p>
        <p class="about__role" data-reveal style="--i:1">Founder and Human-Centered AI Consultant, Suunta Labs Inc.</p>
        <h2 class="h2 about__title" id="about-title" data-split>
          Global HR and Total Rewards Experience as an <em>AI Transformation Advantage</em>
        </h2>
      </div>

      <div class="about__portrait">
        <ImageSlot
          label="Portrait of John Hyttinen"
          src="/images/john-hyttinen.jpg"
          alt="John Hyttinen, Founder of Suunta Labs"
          ratio="4 / 5"
          tone="stone"
          parallax={false}
          class="about__photo"
        >
          <span class="about__tag">
            <span class="about__dot"></span>
            Toronto area, working globally
          </span>
        </ImageSlot>
        <div class="about__caption">
          <div>
            <span class="about__name">John Hyttinen</span>
            <span>Founder &amp; Human-Centered AI Consultant</span>
          </div>
          <a class="about__in" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="John Hyttinen on LinkedIn">
            <Icon name="linkedin-logo" />
          </a>
        </div>
      </div>

      <div class="about__copy">
        <div class="about__text">
          <p class="lede" data-reveal>
            I'm John Hyttinen, founder of Suunta Labs and a human-centered AI consultant. I spent more than 25
            years architecting global HR operating models and Total Rewards systems across technology, financial
            services, and retail, from startups to global organizations.
          </p>
          <p class="body" data-reveal>
            That experience gives me a company-wide lens on how work, accountability, and rewards connect. I bring
            that perspective to AI transformation: clarifying who owns the redesigned work, what people and AI
            contribute, how workforce data and system access support it, and how leadership expectations,
            performance measures, recognition, and rewards reinforce adoption.
          </p>
        </div>

        <dl class="creds">
          {credentials.map((c, i) => (
            <div class="creds__group has-badge" data-reveal style={`--i:${i}`}>
              <dt>
                <IconBadge name={c.icon} size="sm" />
                <span>{c.group}</span>
              </dt>
              {c.items.map((item) => <dd>{item}</dd>)}
            </div>
          ))}
        </dl>
      </div>
    </div>

  </div>

  <div class="why">
    <div class="why__bg" aria-hidden="true">
      <img src="/images/finnish-lake.jpg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="wrap why__inner">
      <div class="why__content">
        <p class="why__suunta" data-split>Suunta</p>
        <p class="why__say" data-reveal><span>SOON-tah</span> · direction, in Finnish</p>
        <h3 class="h3 why__title" data-reveal>Why Suunta Labs</h3>
        <p class="why__body" data-reveal style="--i:1">
          Suunta, pronounced SOON-tah, means direction in Finnish. I chose the name because meaningful
          transformation begins with clarity about the value an organization wants to create and the work that
          will create it. Labs reflects the practical nature of the work: explore, redesign, test, learn, and refine
          solutions that fit the organization and the people doing the work.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    row-gap: 36px;
    align-items: start;
  }
  .about__intro,
  .about__copy {
    grid-column: 6 / 13;
  }
  .about__portrait {
    grid-column: 1 / 5;
    grid-row: 1 / span 2;
    position: sticky;
    top: 110px;
  }
  /* Studio portrait: keep it true to life, no colour grade */
  .about__portrait :global(.about__photo img) {
    filter: none;
    object-position: center top;
  }
  .about__portrait :global(.about__photo .slot__px::after) {
    display: none;
  }
  .about__tag {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(245, 244, 240, 0.9);
    color: var(--ink);
    font-size: 11.5px;
    letter-spacing: 0.04em;
  }
  .about__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 0 rgba(14, 116, 144, 0.5);
    animation: live 2.4s ease-out infinite;
  }
  @keyframes live {
    to {
      box-shadow: 0 0 0 9px rgba(14, 116, 144, 0);
    }
  }
  .about__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .about__caption > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .about__name {
    font-family: var(--serif);
    font-size: 19px;
    color: var(--ink);
  }
  .about__in {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .about__in :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .about__in:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .about__role {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .about__title {
    margin-top: 28px;
  }
  .about__text > * + * {
    margin-top: 1.2em;
  }

  .creds {
    margin: 56px 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .creds__group {
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) minmax(0, 5fr);
    column-gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .creds dt {
    grid-row: span 3;
    display: flex;
    align-items: center;
    gap: 14px;
    align-self: start;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-deep);
  }
  .creds dd {
    grid-column: 2;
    margin: 0;
    padding-top: 6px;
    font-size: 15.5px;
    color: var(--ink);
  }
  .creds dd + dd {
    padding-top: 10px;
  }

  .about {
    padding-bottom: 0;
  }
  /* Full-width "Why Suunta Labs" band with the copy set inside the photo */
  .why {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(92vh, 860px);
    margin-top: clamp(96px, 12vw, 160px);
    padding: clamp(80px, 10vw, 140px) 0;
    overflow: hidden;
    isolation: isolate;
  }
  .why__bg {
    position: absolute;
    inset: -6% 0;
    z-index: -1;
  }
  .why__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    /* cool, muted grade so the lake reads as a northern morning */
    filter: saturate(0.35) hue-rotate(12deg) brightness(1.04) contrast(0.98);
  }
  .why__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(245, 244, 240, 0.86) 0%, rgba(245, 244, 240, 0.7) 40%, rgba(245, 244, 240, 0.15) 70%, rgba(245, 244, 240, 0) 100%),
      linear-gradient(180deg, rgba(236, 235, 229, 0.9) 0%, rgba(236, 235, 229, 0) 18%);
  }
  @supports (animation-timeline: view()) {
    .why__bg {
      animation: why-drift linear both;
      animation-timeline: view();
      animation-range: cover;
    }
    @keyframes why-drift {
      from {
        transform: translateY(-4%);
      }
      to {
        transform: translateY(4%);
      }
    }
  }
  .why__inner {
    position: relative;
  }
  .why__content {
    max-width: 600px;
  }
  .why__suunta {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(72px, 11vw, 168px);
    line-height: 0.85;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  .why__say {
    margin-top: 18px;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .why__say span {
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--teal-deep);
  }
  .why__title {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 28px;
    border-top: 1px solid var(--line-strong);
  }
  .why__body {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink);
    max-width: 56ch;
  }
  @media (max-width: 899px) {
    .about__portrait {
      grid-row: auto;
      position: static;
      max-width: 340px;
    }
    .creds__group {
      grid-template-columns: 1fr;
    }
    .creds dt {
      grid-row: auto;
      margin-bottom: 8px;
    }
    .creds dd {
      grid-column: 1;
    }
    .why {
      min-height: 0;
    }
    .why__bg::after {
      background: linear-gradient(180deg, rgba(245, 244, 240, 0.92) 0%, rgba(245, 244, 240, 0.78) 60%, rgba(245, 244, 240, 0.5) 100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .why__bg {
      animation: none;
    }
    .about__dot {
      animation: none;
    }
  }
</style>
