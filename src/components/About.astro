---
import { credentials } from '../data/site';
---

<section class="section section--tint about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="grid about__grid">

      <div class="about__intro">
        <p class="eyebrow" data-reveal>About John Hyttinen</p>
        <p class="about__role" data-reveal style="--i:1">Founder and Human-Centered AI Consultant, Suunta Labs Inc.</p>
        <h2 class="h2 about__title" id="about-title" data-reveal style="--i:2">
          Global HR and Total Rewards Experience as an <em>AI Transformation Advantage</em>
        </h2>
      </div>

      <figure class="about__portrait" data-reveal>
        {/* Placeholder: replace with /images/john-hyttinen.jpg (4:5, at least 1200×1500). */}
        <div class="portrait" role="img" aria-label="Portrait of John Hyttinen (placeholder)">
          <svg class="portrait__lines" viewBox="0 0 400 500" preserveAspectRatio="none" aria-hidden="true">
            <path d="M-10 420 C 120 380, 180 300, 230 220 S 330 80, 420 40" />
            <path d="M-10 470 C 140 430, 210 340, 260 260 S 360 120, 420 90" />
          </svg>
          <span class="portrait__initials">JH</span>
          <span class="portrait__note">Portrait placeholder</span>
        </div>
        <figcaption class="about__caption">
          <span class="about__name">John Hyttinen</span>
          <span>Founder &amp; Human-Centered AI Consultant</span>
        </figcaption>
      </figure>

      <div class="about__copy">
        <div class="about__text">
          <p class="lede" data-reveal>
            I'm John Hyttinen, founder of Suunta Labs and a human-centered AI consultant. I spent more than 25
            years architecting global HR operating models and Total Rewards systems across technology, financial
            services, and retail, from startups to global organizations.
          </p>
          <p class="body" data-reveal>
            That experience gives me a company-wide lens on how work, accountability, and rewards connect. I bring
            that perspective to AI transformation: clarifying who owns the redesigned work, what people and AI
            contribute, how workforce data and system access support it, and how leadership expectations,
            performance measures, recognition, and rewards reinforce adoption.
          </p>
        </div>

        <dl class="creds">
          {credentials.map((c, i) => (
            <div class="creds__group" data-reveal style={`--i:${i}`}>
              <dt>{c.group}</dt>
              {c.items.map((item) => <dd>{item}</dd>)}
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="grid why">
      <div class="why__word" data-reveal>
        <p class="why__suunta">Suunta</p>
        <p class="why__say"><span>SOON-tah</span> · direction, in Finnish</p>
      </div>
      <div class="why__copy">
        <h3 class="h3" data-reveal>Why Suunta Labs</h3>
        <p class="body why__body" data-reveal style="--i:1">
          Suunta, pronounced SOON-tah, means direction in Finnish. I chose the name because meaningful
          transformation begins with clarity about the value an organization wants to create and the work that
          will create it. Labs reflects the practical nature of the work: explore, redesign, test, learn, and refine
          solutions that fit the organization and the people doing the work.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    align-items: start;
  }
  .about__portrait {
    grid-column: 1 / 5;
    grid-row: 1 / span 2;
    margin: 0;
    position: sticky;
    top: 120px;
  }
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: linear-gradient(160deg, var(--ink-2) 0%, var(--night) 100%);
    border-radius: var(--radius);
  }
  .portrait__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--teal-light);
    stroke-width: 1;
    opacity: 0.35;
  }
  .portrait__lines path + path {
    opacity: 0.5;
    stroke-dasharray: 2 5;
  }
  .portrait__initials {
    position: absolute;
    left: 28px;
    bottom: 22px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(72px, 8vw, 120px);
    line-height: 1;
    color: var(--on-night);
    opacity: 0.9;
  }
  .portrait__note {
    position: absolute;
    top: 22px;
    left: 28px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-night-soft);
  }
  .about__caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .about__name {
    font-family: var(--serif);
    font-size: 19px;
    color: var(--ink);
  }

  .about__intro,
  .about__copy {
    grid-column: 6 / 13;
  }
  .about__role {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .about__title {
    margin-top: 28px;
  }
  .about__grid {
    row-gap: 36px;
  }
  .about__text > * + * {
    margin-top: 1.2em;
  }

  .creds {
    margin: 56px 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .creds__group {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    column-gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .creds dt {
    grid-row: span 3;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-deep);
    padding-top: 3px;
  }
  .creds dd {
    grid-column: 2;
    margin: 0;
    font-size: 15.5px;
    color: var(--ink);
  }
  .creds dd + dd {
    margin-top: 10px;
  }

  .why {
    margin-top: clamp(96px, 12vw, 160px);
    padding-top: 48px;
    border-top: 1px solid var(--line);
    row-gap: 32px;
    align-items: end;
  }
  .why__word {
    grid-column: 1 / 7;
  }
  .why__suunta {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(80px, 12vw, 176px);
    line-height: 0.85;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  .why__say {
    margin-top: 20px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .why__say span {
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--teal-deep);
  }
  .why__copy {
    grid-column: 7 / 13;
  }
  .why__body {
    margin-top: 16px;
  }

  @media (max-width: 899px) {
    .about__portrait {
      grid-row: auto;
      position: static;
      max-width: 320px;
    }
    .creds__group {
      grid-template-columns: 1fr;
    }
    .creds dt {
      grid-row: auto;
      margin-bottom: 10px;
    }
    .creds dd {
      grid-column: 1;
    }
  }
</style>
