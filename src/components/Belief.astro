---
import Mark from './Mark.astro';
import Icon from './Icon.astro';

// Slow drifting contour lines behind the quote.
const lines = Array.from({ length: 14 }, (_, k) => {
  const y = 40 + k * 38;
  return `M-50 ${y} C 250 ${y - 60 - k * 4}, 550 ${y + 70}, 850 ${y - 20} S 1350 ${y + 50 - k * 3}, 1650 ${y - 10}`;
});
---

<section class="section section--night belief" id="belief" aria-labelledby="belief-title">
  <svg class="belief__bg" viewBox="0 0 1600 600" preserveAspectRatio="none" aria-hidden="true">
    {lines.map((d, i) => <path d={d} style={`--k:${i}`} />)}
  </svg>
  <div class="wrap grid">
    <div class="belief__label">
      <p class="eyebrow" data-reveal>The belief behind the work</p>
      <Mark class="belief__mark" />
    </div>
    <div class="belief__copy">
      <span class="belief__icon" data-reveal><Icon name="quotes" /></span>
      <h2 class="belief__quote" id="belief-title" data-split>
        Underneath the work is a simple belief: <em>people should find more meaning in their work and more freedom
        in their lives.</em>
      </h2>
      <p class="lede belief__lede" data-reveal style="--i:2">
        Redesigning how people and AI work together can create measurable business value while also giving people
        greater clarity, confidence, agency, trust, and meaning in how they contribute.
      </p>
    </div>
  </div>
</section>

<style>
  .belief {
    position: relative;
    overflow: hidden;
  }
  .belief__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--teal-light);
    stroke-width: 1;
    opacity: 0.12;
    pointer-events: none;
  }
  .belief__bg path {
    animation: drift 18s ease-in-out infinite alternate;
    animation-delay: calc(var(--k) * -1.3s);
  }
  @keyframes drift {
    to {
      transform: translateY(18px);
    }
  }
  .belief .wrap {
    position: relative;
  }
  .belief__icon {
    display: block;
    margin-bottom: 28px;
    color: var(--teal-light);
  }
  .belief__icon :global(.icon) {
    width: 52px;
    height: 52px;
  }
  .belief__label {
    grid-column: 1 / 4;
    padding-top: 16px;
  }
  .belief__label :global(.belief__mark) {
    width: 34px;
    margin-top: 48px;
    color: var(--teal-light);
    opacity: 0.8;
  }
  .belief__copy {
    grid-column: 4 / 12;
  }
  .belief__quote {
    font-family: var(--serif);
    font-weight: 340;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }
  .belief__quote em {
    color: var(--teal-light);
    font-weight: 320;
  }
  .belief__lede {
    margin-top: 40px;
  }
  @media (prefers-reduced-motion: reduce) {
    .belief__bg path {
      animation: none;
    }
  }
  @media (max-width: 899px) {
    .belief__label :global(.belief__mark) {
      display: none;
    }
    .belief__copy {
      margin-top: 28px;
    }
  }
</style>
