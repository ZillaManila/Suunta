---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
---

<section class="section section--night belief" id="belief" aria-labelledby="belief-title">
  <div class="belief__bg" aria-hidden="true">
    <img src="/images/belief-forest.jpg" alt="" loading="lazy" decoding="async" />
  </div>
  <div class="wrap grid">
    <div class="belief__label">
      <p class="eyebrow" data-reveal>The belief behind the work</p>
      <Mark class="belief__mark" />
    </div>
    <div class="belief__copy">
      <span class="belief__icon" data-reveal><Icon name="quotes" /></span>
      <h2 class="belief__quote" id="belief-title" data-split>
        Underneath the work is a simple belief: <em>people should find more meaning in their work and more freedom
        in their lives.</em>
      </h2>
      <p class="lede belief__lede" data-reveal style="--i:2">
        Redesigning how people and AI work together can create measurable business value while also giving people
        greater clarity, confidence, agency, trust, and meaning in how they contribute.
      </p>
    </div>
  </div>
</section>

<style>
  .belief {
    position: relative;
    overflow: hidden;
  }
  /* Background photo: frosted pine forest in fog, under a navy wash */
  .belief__bg {
    position: absolute;
    inset: -8% 0;
    pointer-events: none;
  }
  .belief__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: grayscale(0.3) contrast(1.1);
  }
  .belief__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(15, 26, 45, 0.5) 0%, rgba(15, 26, 45, 0.7) 45%, rgba(15, 26, 45, 0.8) 100%),
      linear-gradient(180deg, rgba(15, 26, 45, 0.5) 0%, rgba(15, 26, 45, 0) 30%, rgba(15, 26, 45, 0) 70%, rgba(15, 26, 45, 0.6) 100%);
    mix-blend-mode: normal;
  }
  /* Slow parallax drift while the section scrolls by */
  @supports (animation-timeline: view()) {
    .belief__bg {
      animation: belief-drift linear both;
      animation-timeline: view();
      animation-range: cover;
    }
    @keyframes belief-drift {
      from {
        transform: translateY(-5%);
      }
      to {
        transform: translateY(5%);
      }
    }
  }
  .belief .wrap {
    position: relative;
  }
  .belief__icon {
    display: block;
    margin-bottom: 28px;
    color: var(--teal-light);
  }
  .belief__icon :global(.icon) {
    width: 52px;
    height: 52px;
  }
  .belief__label {
    grid-column: 1 / 4;
    padding-top: 16px;
  }
  .belief__label :global(.belief__mark) {
    width: 34px;
    margin-top: 48px;
    color: var(--teal-light);
    opacity: 0.8;
  }
  .belief__copy {
    grid-column: 4 / 12;
  }
  .belief__quote {
    font-family: var(--serif);
    font-weight: 340;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }
  .belief__quote em {
    color: var(--teal-light);
    font-weight: 320;
  }
  .belief__lede {
    margin-top: 40px;
  }
  @media (prefers-reduced-motion: reduce) {
    .belief__bg {
      animation: none;
    }
  }
  @media (max-width: 899px) {
    .belief__label :global(.belief__mark) {
      display: none;
    }
    .belief__copy {
      margin-top: 28px;
    }
  }
</style>
