---
// Layout follows the reference landing page's "Method" split: a large photo with a caption
// tag beside a numbered accordion. Each brief has its own photo; opening a brief swaps it.
import Mark from './Mark.astro';
import { insights } from '../data/site';

const photos = [
  { src: '/images/brief-1.jpg', alt: 'A team reviewing an AI initiative together around a table' },
  { src: '/images/brief-2.jpg', alt: 'Colleagues discussing results in a working session' },
  { src: '/images/brief-3.jpg', alt: 'A team working through plans at their laptops' },
  { src: '/images/brief-4.jpg', alt: 'A team redesigning a workflow around a shared table' },
  { src: '/images/brief-5.jpg', alt: 'A leader talking a team through how their work is changing' },
];
---

<section class="insights" id="insights" aria-labelledby="insights-title">
  <div class="ins-split">
    <div class="ins-media">
      <div class="ins-media__sticky" data-reveal>
        {photos.map((p, i) => (
          <img
            class:list={['ins-photo', { 'is-active': i === 0 }]}
            src={p.src}
            alt={i === 0 ? p.alt : ''}
            data-alt={p.alt}
            loading={i === 0 ? 'lazy' : 'lazy'}
            decoding="async"
            data-ins-photo={i}
          />
        ))}
        <p class="ins-tag" aria-live="polite" data-ins-tag>
          {insights[0].title}
        </p>
      </div>
    </div>

    <div class="ins-copy">
      <p class="eyebrow" data-reveal>Executive insights</p>
      <h2 class="h2 ins-title" id="insights-title" data-split>Executive Insights on AI Adoption and Value</h2>
      <p class="ins-sub" data-reveal>
        AI is changing quickly. These concise briefs translate current research into practical questions for leaders
        who want AI adoption to create measurable business value.
      </p>
      <p class="ins-lead" data-reveal>
        Each brief distinguishes the published evidence from the Suunta Labs interpretation and connects the research
        to practical decisions about AI adoption and value.
      </p>

      <div class="briefs" data-accordion data-single data-ins-accordion>
        {insights.map((b, i) => (
          <div class:list={['brief', { 'is-open': i === 0 }]} data-acc-item data-title={b.title}>
            <h3 class="brief__h">
              <button
                class="brief__head"
                type="button"
                data-acc-trigger
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`brief-panel-${i}`}
                id={`brief-trigger-${i}`}
              >
                <span class="brief__num">{i + 1}.</span>
                <span class="brief__title"><span>{b.title}</span></span>
                <span class="zip-track" aria-hidden="true">
                  <span class="zip-pull"><Mark /></span>
                </span>
              </button>
            </h3>
            <div class="brief__panel" id={`brief-panel-${i}`} role="region" aria-labelledby={`brief-trigger-${i}`} data-acc-panel>
              <div>
                <div class="brief__inner">
                  <img class="brief__img" src={photos[i].src} alt="" loading="lazy" decoding="async" />
                  <p class="brief__question">{b.question}</p>
                  <div class="brief__col">
                    <h4>What the research found.</h4>
                    <p>{b.found}</p>
                  </div>
                  <div class="brief__col brief__col--means">
                    <h4>What it means for leaders.</h4>
                    <p>{b.means}</p>
                  </div>
                  <div class="brief__sources">
                    {b.sources.map((s) => (
                      <p>
                        Source:{' '}
                        <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                      </p>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p class="ins-close" data-reveal>
        These findings point to a connected leadership agenda: choose a business priority, redesign how people and AI
        contribute, rebuild the workflow around value, create the conditions for adoption, and
        <b>measure the result.</b>
      </p>
    </div>
  </div>
</section>

<style>
  .insights {
    padding-top: clamp(80px, 10vw, 140px);
  }
  .ins-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .ins-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Photo column */
  .ins-media {
    position: relative;
    min-height: 340px;
  }
  .ins-media__sticky {
    position: relative;
    height: 100%;
    min-height: 340px;
    overflow: hidden;
    background: var(--paper-3);
  }
  @media (min-width: 900px) {
    .ins-media__sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      max-height: 900px;
    }
  }
  .ins-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    filter: saturate(0.95) contrast(1.04);
    transition: opacity 0.9s var(--ease), transform 1.6s var(--ease);
  }
  .ins-photo.is-active {
    opacity: 1;
    transform: none;
  }
  .ins-media__sticky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(14, 116, 144, 0.04), rgba(15, 26, 45, 0.08));
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .ins-tag {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    max-width: 86%;
    padding: 18px 22px;
    background: var(--mist);
    color: var(--ink);
    font-size: 15px;
    line-height: 1.45;
    font-weight: 500;
  }

  /* Copy column */
  .ins-copy {
    padding: 48px var(--gutter) 64px;
  }
  @media (min-width: 900px) {
    .ins-copy {
      padding: 64px max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))) 96px 56px;
    }
  }
  .ins-title {
    margin: 22px 0 18px;
    font-size: clamp(32px, 3.4vw, 48px);
  }
  .ins-sub {
    margin-bottom: 14px;
    font-size: clamp(17px, 1.4vw, 19px);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
  }
  .ins-lead {
    margin-bottom: 30px;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .briefs {
    border-top: 1.5px solid var(--ink);
  }
  .brief {
    border-bottom: 1.5px solid var(--ink);
  }
  .brief__h {
    margin: 0;
  }
  .brief__head {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 64px;
    padding: 18px 0;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .brief__num {
    flex: none;
    font-family: var(--serif);
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 300;
    color: var(--teal-deep);
  }
  .brief__title {
    flex: 1;
    font-family: var(--serif);
    font-size: clamp(19px, 1.7vw, 23px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .brief__title span {
    background: linear-gradient(transparent 62%, var(--mist) 62%) left / 0% 100% no-repeat;
    transition: background-size 0.7s var(--ease);
  }
  .brief.is-open .brief__title span {
    background-size: 100% 100%;
  }
  .brief__head:hover .brief__title {
    color: var(--teal-deep);
  }

  /* arrowhead travels down a dotted track as the item opens */
  .zip-track {
    position: relative;
    width: 22px;
    height: 32px;
    flex: none;
  }
  .zip-track::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: repeating-linear-gradient(180deg, var(--teal) 0 3px, transparent 3px 6px);
    opacity: 0.45;
    transition: opacity 0.3s;
  }
  .zip-pull {
    position: absolute;
    left: 50%;
    top: 0;
    width: 14px;
    color: var(--teal);
    transform: translateX(-50%) rotate(180deg);
    transition: top 0.5s cubic-bezier(0.65, 0, 0.35, 1), transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .zip-pull :global(svg) {
    width: 100%;
    height: auto;
  }
  .brief.is-open .zip-pull {
    top: calc(100% - 16px);
    transform: translateX(-50%) rotate(0deg);
  }
  .brief.is-open .zip-track::before {
    opacity: 1;
  }

  .brief__inner {
    padding: 0 40px 28px 0;
  }
  .brief__img {
    display: none;
  }
  @media (max-width: 899px) {
    /* On phones the main photo is out of view, so each brief shows its own */
    .ins-media {
      display: none;
    }
    .brief__img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      margin-bottom: 18px;
      filter: saturate(0.95) contrast(1.04);
    }
    .brief__inner {
      padding-right: 0;
    }
  }
  .brief__question {
    margin: 0 0 22px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.45;
    color: var(--ink);
  }
  .brief__col h4 {
    margin: 0 0 8px;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .brief__col p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .brief__col--means {
    margin-top: 20px;
    padding-left: 18px;
    border-left: 2px solid var(--teal);
  }
  .brief__col--means h4 {
    color: var(--teal-deep);
  }
  .brief__col--means p {
    color: var(--ink);
  }
  .brief__sources {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--ink-muted);
  }
  .brief__sources p + p {
    margin-top: 4px;
  }
  .brief__sources a {
    color: var(--ink-soft);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .brief__sources a:hover {
    color: var(--teal-deep);
    text-decoration-color: var(--teal);
  }

  .ins-close {
    margin-top: 30px;
    font-family: var(--serif);
    font-size: clamp(19px, 1.7vw, 22px);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  .ins-close b {
    padding: 0 6px;
    font-weight: 500;
    background: var(--mist);
  }

  @media (prefers-reduced-motion: reduce) {
    .ins-photo,
    .zip-pull {
      transition: none;
    }
  }
</style>

<script>
  // Swap the photo and caption to match the open brief.
  const acc = document.querySelector<HTMLElement>('[data-ins-accordion]');
  const photos = [...document.querySelectorAll<HTMLImageElement>('[data-ins-photo]')];
  const tag = document.querySelector<HTMLElement>('[data-ins-tag]');
  const items = acc ? [...acc.querySelectorAll<HTMLElement>('[data-acc-item]')] : [];

  acc?.addEventListener('acc:change', (e) => {
    const { index, open } = (e as CustomEvent<{ index: number; open: boolean }>).detail;
    if (!open) return; // keep the last photo when a brief is closed
    photos.forEach((img, i) => {
      const on = i === index;
      img.classList.toggle('is-active', on);
      img.alt = on ? img.dataset.alt || '' : '';
    });
    if (tag) {
      tag.textContent = items[index]?.dataset.title || '';
    }
  });
</script>
