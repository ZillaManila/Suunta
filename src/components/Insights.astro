---
import Icon from './Icon.astro';
import { insights } from '../data/site';
---

<section class="section insights" id="insights" aria-labelledby="insights-title">
  <div class="wrap">
    <div class="grid insights__head">
      <div class="insights__label">
        <p class="eyebrow" data-reveal>Executive insights</p>
      </div>
      <div class="insights__intro">
        <h2 class="h2" id="insights-title" data-split>Executive Insights on AI Adoption and Value</h2>
        <p class="lede insights__lede" data-reveal style="--i:1">
          AI is changing quickly. These concise briefs translate current research into practical questions for
          leaders who want AI adoption to create measurable business value.
        </p>
        <p class="body insights__sub" data-reveal style="--i:2">
          Each brief distinguishes the published evidence from the Suunta Labs interpretation and connects the
          research to practical decisions about AI adoption and value.
        </p>
      </div>
    </div>

    <div class="briefs">
      {insights.map((b, i) => (
        <details class="brief" data-reveal open={i === 0}>
          <summary class="brief__summary">
            <span class="brief__index">
              <span class="brief__icon"><Icon name="book-open-text" /></span>
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="brief__heading">
              <span class="brief__meta">
                <span class="chip">{b.publisher}</span>
                <span class="brief__kind">Executive brief</span>
              </span>
              <span class="brief__title">{b.title}</span>
              <span class="brief__question">{b.question}</span>
            </span>
            <span class="brief__toggle" aria-hidden="true"></span>
          </summary>
          <div class="brief__body">
            <div class="brief__col">
              <h3 class="brief__label">What the research found</h3>
              <p>{b.found}</p>
            </div>
            <div class="brief__col brief__col--means">
              <h3 class="brief__label">What it means for leaders</h3>
              <p>{b.means}</p>
            </div>
            <div class="brief__sources">
              {b.sources.map((s) => (
                <p>
                  Source:{' '}
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.label}
                  </a>
                </p>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>

    <div class="grid insights__foot">
      <p class="insights__close" data-reveal>
        These findings point to a connected leadership agenda: choose a business priority, redesign how people and
        AI contribute, rebuild the workflow around value, create the conditions for adoption, and measure the
        result.
      </p>
    </div>
  </div>
</section>

<style>
  .insights__label {
    grid-column: 1 / 5;
    padding-top: 14px;
  }
  .insights__intro {
    grid-column: 5 / 13;
  }
  .insights__lede {
    margin-top: 28px;
  }
  .insights__sub {
    margin-top: 18px;
    font-size: 15.5px;
  }
  .briefs {
    margin-top: clamp(64px, 8vw, 104px);
    border-top: 1px solid var(--line-strong);
  }
  .brief {
    border-bottom: 1px solid var(--line);
  }
  .brief__summary {
    display: grid;
    grid-template-columns: 64px 1fr 40px;
    gap: clamp(16px, 2.4vw, 32px);
    align-items: start;
    padding: 32px 0;
    cursor: pointer;
    list-style: none;
  }
  .brief__summary::-webkit-details-marker {
    display: none;
  }
  .brief__index {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 2px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--teal);
  }
  .brief__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(14, 116, 144, 0.35);
    color: var(--teal-deep);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease);
  }
  .brief__icon :global(.icon) {
    width: 22px;
    height: 22px;
  }
  .brief__summary:hover .brief__icon,
  .brief[open] .brief__icon {
    background: var(--teal);
    border-color: var(--teal);
    color: #fff;
  }
  .brief__meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brief__meta .chip {
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brief__kind {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .brief__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .brief__title {
    font-family: var(--serif);
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    transition: color 0.3s;
  }
  .brief__summary:hover .brief__title {
    color: var(--teal-deep);
  }
  .brief__question {
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 70ch;
  }
  .brief__toggle {
    position: relative;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background-color 0.3s, border-color 0.3s;
  }
  .brief__toggle::before,
  .brief__toggle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition: transform 0.4s var(--ease), background-color 0.3s;
  }
  .brief__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .brief[open] .brief__toggle {
    background: var(--ink);
    border-color: var(--ink);
  }
  .brief[open] .brief__toggle::before,
  .brief[open] .brief__toggle::after {
    background: #fff;
  }
  .brief[open] .brief__toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .brief__body {
    display: grid;
    grid-template-columns: 64px 1fr 1fr 40px;
    column-gap: clamp(16px, 2.4vw, 32px);
    row-gap: 28px;
    padding-bottom: 40px;
  }
  .brief[open] .brief__body {
    animation: brief-in 0.6s var(--ease);
  }
  @keyframes brief-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .brief__col {
    grid-column: 2;
  }
  .brief__col--means {
    grid-column: 3;
    padding-left: clamp(16px, 2.4vw, 32px);
    border-left: 1px solid var(--teal);
  }
  .brief__label {
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .brief__col--means .brief__label {
    color: var(--teal-deep);
  }
  .brief__col p {
    font-size: 15.5px;
    color: var(--ink-soft);
  }
  .brief__col--means p {
    color: var(--ink);
  }
  .brief__sources {
    grid-column: 2 / 4;
    font-size: 13px;
    color: var(--ink-muted);
  }
  .brief__sources p + p {
    margin-top: 4px;
  }
  .brief__sources a {
    color: var(--ink-soft);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .brief__sources a:hover {
    color: var(--teal-deep);
    text-decoration-color: var(--teal);
  }
  .insights__foot {
    margin-top: clamp(64px, 8vw, 104px);
  }
  .insights__close {
    grid-column: 5 / 12;
    font-family: var(--serif);
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.35;
    text-wrap: pretty;
  }

  @media (max-width: 899px) {
    .insights__intro {
      margin-top: 20px;
    }
    .brief__summary {
      grid-template-columns: 1fr 40px;
    }
    .brief__index {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
    }
    .brief__body {
      grid-template-columns: 1fr;
    }
    .brief__col,
    .brief__col--means,
    .brief__sources {
      grid-column: 1;
    }
  }
</style>
