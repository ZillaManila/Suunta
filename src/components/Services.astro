---
import ArrowIcon from './ArrowIcon.astro';
import IconBadge from './IconBadge.astro';
import Icon from './Icon.astro';
import { services, site } from '../data/site';
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="grid services__head">
      <div class="services__label">
        <p class="eyebrow" data-reveal>Services</p>
      </div>
      <div class="services__intro">
        <h2 class="h2" id="services-title" data-split>AI Transformation From Strategy Through Adoption</h2>
        <p class="lede services__lede" data-reveal style="--i:1">
          I help executive teams connect AI strategy, implementation, and adoption through an operating model that
          brings together people, technology, workflows, leadership, accountability, and measurable value.
        </p>
      </div>
    </div>

    <ul class="svc" role="list">
      {services.map((s, i) => (
        <li class:list={['svc__row has-badge', { 'svc__row--start': i === 0 }]} data-reveal>
          <span class="svc__index">
            <IconBadge name={s.icon} tone={i === 0 ? 'solid' : 'line'} />
            <span>{String(i + 1).padStart(2, '0')}</span>
          </span>
          <h3 class="svc__name">
            {s.name}
            {i === 0 && <span class="svc__badge">Start here</span>}
          </h3>
          <p class="svc__body">{s.body}</p>
          <span class="svc__go" aria-hidden="true"><Icon name="arrow-up-right" /></span>
        </li>
      ))}
    </ul>

    <div class="grid services__foot">
      <p class="services__note" data-reveal>
        Every engagement starts with a Direction Call. From there, I recommend the right next step, and each scope
        is designed around your priorities, context, people, systems, and readiness.
      </p>
      <div class="services__cta" data-reveal style="--i:1">
        <a class="btn" href={site.bookingUrl} data-magnetic>Start with a Direction Call <ArrowIcon /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .services__label {
    grid-column: 1 / 5;
    padding-top: 14px;
  }
  .services__intro {
    grid-column: 5 / 13;
  }
  .services__lede {
    margin-top: 28px;
  }
  .svc {
    list-style: none;
    margin-top: clamp(64px, 8vw, 104px);
    border-top: 1px solid var(--line-strong);
  }
  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.4vw, 32px);
    row-gap: 12px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  .svc__row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.5);
    z-index: -1;
    background: var(--paper-2);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease);
  }
  .svc__row:hover::before {
    transform: scaleY(1);
  }
  .svc__index {
    grid-column: 1 / 3;
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--teal);
  }
  .svc__go {
    grid-column: 12 / 13;
    justify-self: end;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition: transform 0.5s var(--ease), background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .svc__go :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .svc__row:hover .svc__go {
    transform: rotate(45deg);
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .svc__name {
    grid-column: 3 / 6;
    font-family: var(--serif);
    font-size: clamp(22px, 1.9vw, 27px);
    line-height: 1.2;
    letter-spacing: -0.008em;
  }
  .svc__badge {
    display: inline-block;
    margin-left: 10px;
    padding: 4px 8px;
    vertical-align: 4px;
    font-family: var(--sans);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-deep);
    border: 1px solid rgba(14, 116, 144, 0.4);
    border-radius: var(--radius);
  }
  .svc__body {
    grid-column: 6 / 12;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .svc__row--start .svc__name {
    color: var(--teal-deep);
  }
  .services__foot {
    margin-top: 56px;
    row-gap: 32px;
    align-items: center;
  }
  .services__note {
    grid-column: 2 / 8;
    font-family: var(--serif);
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .services__cta {
    grid-column: 9 / 13;
    justify-self: end;
  }

  @media (max-width: 899px) {
    .services__intro {
      margin-top: 20px;
    }
    .svc__row {
      grid-template-columns: 1fr 40px;
      align-items: start;
    }
    .svc__index,
    .svc__name,
    .svc__body {
      grid-column: 1;
    }
    .svc__go {
      grid-column: 2;
      grid-row: 1;
    }
    .services__cta {
      justify-self: start;
    }
  }
</style>
