---
// Phosphor "light" icons, inlined at build time so they inherit currentColor.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  name: string;
  class?: string;
  size?: number;
  label?: string;
}

const { name, class: className, size, label } = Astro.props;
const file = join(process.cwd(), 'node_modules/@phosphor-icons/core/assets/light', `${name}-light.svg`);
const inner = readFileSync(file, 'utf8')
  .replace(/^<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '');
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 256 256"
  fill="currentColor"
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={inner}
/>
