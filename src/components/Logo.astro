---
// Official Suunta Labs logo (mark, wordmark and tagline). The light version is for dark backgrounds.
interface Props { tone?: 'ink' | 'light'; class?: string }
const { tone = 'ink', class: className } = Astro.props;
const src = tone === 'light' ? '/images/suunta-labs-logo-light.png' : '/images/suunta-labs-logo.png';
---
<img class:list={['logo', className]} src={src} alt="Suunta Labs, Direction for Better Work" width="760" height="176" decoding="async" />

<style>
  .logo {
    display: block;
    width: auto;
    height: 40px;
  }
</style>
