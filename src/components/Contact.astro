---
import ArrowIcon from './ArrowIcon.astro';
import Icon from './Icon.astro';
import IconBadge from './IconBadge.astro';
import { bring, site } from '../data/site';
---

<section class="section section--night contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div class="contact__main">
      <p class="eyebrow" data-reveal>Find your direction</p>
      <h2 class="contact__title" id="contact-title" data-split>
        Begin With <em>Direction</em>
      </h2>
      <p class="lede contact__lede" data-reveal style="--i:2">
        Bring one business priority where AI could improve how work gets done. A Direction Call explores the
        outcome you want, the work involved, and the questions that deserve executive attention.
      </p>
      <p class="body contact__after" data-reveal style="--i:3">
        After the call, I recommend an assessment, diagnostic, or advisory path suited to your context and
        readiness.
      </p>
      <div class="contact__cta" data-reveal style="--i:4">
        <a class="btn btn--light" href={site.bookingUrl} data-magnetic>Book a Direction Call <ArrowIcon /></a>
      </div>
    </div>

    <aside class="contact__bring" data-reveal style="--i:2">
      <div class="contact__person">
        <img class="contact__avatar" src="/images/john-hyttinen-headshot.jpg" alt="John Hyttinen" width="64" height="64" loading="lazy" decoding="async" />
        <div>
          <p class="contact__person-name">John Hyttinen</p>
          <p class="contact__person-role">Founder and Human-Centered AI Consultant, Suunta Labs Inc.</p>
        </div>
      </div>
      <p class="contact__bring-title">You may want to bring:</p>
      <ol role="list">
        {bring.map((b) => (
          <li class="has-badge">
            <IconBadge name={b.icon} tone="night" size="sm" />
            <span class="contact__bring-text">{b.text}</span>
          </li>
        ))}
      </ol>
      <div class="contact__direct">
        <a href={`mailto:${site.email}`}><Icon name="envelope-simple" />{site.email}</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin-logo" />{site.linkedinLabel}</a>
        <span><Icon name="map-pin" />{site.location}</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(80px, 10vw, 136px);
  }
  .contact::before {
    /* faint compass rose behind the headline */
    content: '';
    position: absolute;
    width: 900px;
    height: 900px;
    left: -280px;
    top: -260px;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, rgba(107, 184, 201, 0.09) 0 1px, transparent 1px 48px);
    animation: contact-breathe 14s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes contact-breathe {
    to {
      transform: scale(1.08) rotate(8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact::before {
      animation: none;
    }
  }
  .contact .wrap {
    position: relative;
  }
  .contact__main {
    grid-column: 1 / 8;
  }
  .contact__title {
    margin-top: 28px;
    font-family: var(--serif);
    font-weight: 340;
    font-size: clamp(52px, 8vw, 116px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .contact__title em {
    color: var(--teal-light);
    font-weight: 300;
  }
  .contact__lede {
    margin-top: 36px;
  }
  .contact__after {
    margin-top: 18px;
  }
  .contact__cta {
    margin-top: 44px;
  }
  .contact__bring {
    grid-column: 9 / 13;
    align-self: end;
    margin-top: 56px;
  }
  .contact__bring-title {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-night);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-night-soft);
  }
  .contact__bring ol {
    list-style: none;
  }
  .contact__person {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
  }
  .contact__avatar {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--night), 0 0 0 3px rgba(107, 184, 201, 0.6);
  }
  .contact__person-name {
    font-family: var(--serif);
    font-size: 21px;
    color: var(--on-night);
  }
  .contact__person-role {
    font-size: 13.5px;
    color: var(--on-night-soft);
  }
  .contact__bring li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-night);
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.4;
  }

  .contact__direct {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 32px;
    font-size: 14.5px;
    color: var(--on-night-soft);
  }
  .contact__direct a,
  .contact__direct span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .contact__direct :global(.icon) {
    width: 18px;
    height: 18px;
    color: var(--teal-light);
  }
  .contact__direct a {
    color: var(--on-night);
    text-decoration: none;
    width: fit-content;
    background: linear-gradient(var(--teal-light), var(--teal-light)) left bottom / 0 1px no-repeat;
    transition: background-size 0.4s var(--ease);
  }
  .contact__direct a:hover {
    background-size: 100% 1px;
  }
</style>
